@using ConvergenceCorpBlazor.Classes.Model;
@using ConvergenceCorpBlazor.Classes.Model.Game;

<h2>Public Convergences</h2>

@foreach(Tuple<GameRegion, DateTimeOffset> g in tuples)
{
    <PublicTimer gameRegion="@g.Item1" TimerSize="Small"/>
}

@code{
    List<Tuple<GameRegion, DateTimeOffset>> tuples = [
        new Tuple<GameRegion, DateTimeOffset>(GameRegion.Sky, PublicTime.GetNextAreaTime(GameRegion.Sky)),
        new Tuple<GameRegion, DateTimeOffset>(GameRegion.Wild, PublicTime.GetNextAreaTime(GameRegion.Wild)),
        new Tuple<GameRegion, DateTimeOffset>(GameRegion.Magic, PublicTime.GetNextAreaTime(GameRegion.Magic))
    ];

    protected override void OnInitialized()
    {
        //sort the tuples by their times. Soonest first.
        tuples = tuples.OrderBy(t => t.Item2).ToList();
        base.OnInitialized();
    }
}
