<!-- End of VoE box -->

@code {
    DateTimeOffset instanceopentime = DateTimeOffset.UtcNow + new TimeSpan(4, 0, 0);

    static List<string> imagelinks = [
        "", //none
        "", //tyria
        "", //hot
        "", //pof
        "", //eod
        "SotO/sotoconverge.jpg", //soto
        "JW/janthirconverge.jpg", //jw
        "VoE/voeconverge.jpg" //voe
    ];

    static List<string> links = [
        "", //none
        "", //tyria
        "", //hot
        "", //pof
        "", //eod
        "soto",
        "jw",
        "voe"
    ];

    [Parameter]
    public String TimerSize { get; set; } = "Large";
    [Parameter]
    public required GameRegion gameRegion { get; set; } = GameRegion.None;

    protected override void OnParametersSet()
    {
        instanceopentime = PublicTime.GetNextAreaTime(gameRegion);

        JS.InvokeVoidAsync("SetCountdownTime", (int)gameRegion, instanceopentime);
        JS.InvokeVoidAsync("StartInterval", (int)gameRegion);
        base.OnParametersSet();
    }
    
    protected override void OnAfterRender(bool firstRender)
    {
        if(TimerSize == "Large")
        {
            //Invoke the JS function "ConvertToLocal" on the client side.
            JS.InvokeVoidAsync("ConvertLocalToLocal");
        }
        base.OnAfterRender(firstRender);
    }
}