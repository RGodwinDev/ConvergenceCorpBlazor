@using ConvergenceCorpBlazor.Classes.Model.Game; <!-- for GameRegion-->
@using ConvergenceCorpBlazor.Classes.Model; <!-- for PublicTime-->
@inject IJSRuntime JS

@if (gameRegion == GameRegion.Sky || gameRegion == GameRegion.Wild || gameRegion == GameRegion.Magic) //add new regions here when they get a convergence!
{
    @if (TimerSize == "Large")
    {
        <h3>
            <img src=@Assets["/images/" + @imagelinks[(int)gameRegion]] alt="@gameRegion logo" style="width:50px;" />
            Public Convergence Times
        </h3>

        <p>
            Public instances open every 3 hours.
        </p>
        <p class="timercontain@((int)gameRegion)">
            Next Public opens at <span class="time localtime">@instanceopentime</span> in
            <span class="Timer@((int)gameRegion) time" >00:00:00</span>
        </p>
    }
    else if (TimerSize == "Small")
    {
        <a href="/@links[(int)gameRegion]">
            <div class="PublicTimerContainSmall timercontain@((int)gameRegion)">
                <img src=@Assets["/images/" + @imagelinks[(int)gameRegion]] alt="@gameRegion logo" style="width:50px;" />
                <div>
                        Open in <span class="time Timer@((int)gameRegion)">00:00:00</span>
                </div>
            </div>
        </a>
    }
}

<script>
    function ConvertLocalToLocal(){
        var times = document.getElementsByClassName("localtime");
        for(var t of times){
            ConvertToLocal(t);
        }
    }
</script>


