@using ConvergenceCorpBlazor.Classes.Model.Game; <!-- for GameRegion-->
@using ConvergenceCorpBlazor.Classes.Model; <!-- for PublicTime-->
@inject IJSRuntime JS

@if (gameRegion == GameRegion.Sky || gameRegion == GameRegion.Wild || gameRegion == GameRegion.Magic) //add new regions here when they get a convergence!
{
    @if (TimerSize == "Large")
    {
        <h3>
            <img src=@Assets["/images/" + @imagelinks[(int)gameRegion]] alt="@gameRegion logo" style="width:50px;" />
            Public Convergence Times
        </h3>

        <p>
            Public instances open every 3 hours.
        </p>
        <p class="timercontain@((int)gameRegion)">
            Next Public opens at <span class="time localtime">@instanceopentime</span> in
            <span class="Timer@((int)gameRegion) time" >00:00:00</span>
        </p>
    }
    else if (TimerSize == "Small")
    {
        <a href="/@links[(int)gameRegion]">
            <div class="PublicTimerContainSmall timercontain@((int)gameRegion)">
                <img src=@Assets["/images/" + @imagelinks[(int)gameRegion]] alt="@gameRegion logo" style="width:50px;" />
                <div>
                        Open in <span class="time Timer@((int)gameRegion)">00:00:00</span>
                </div>
            </div>
        </a>
    }
    else if(TimerSize == "Card")
    {
        <div class="card" 
            style=" width:300px;
                    min-width:300px; 
                    
                    border:solid 2px transparent;
                    border-image:linear-gradient(to right,@GameRegionData.Data[(int)gameRegion].Color1, @GameRegionData.Data[(int)gameRegion].Color2);
                    border-image-slice:1;"
            >
            <img class="card-img-top" src=@Assets["/images/" + @imagelinks[(int)gameRegion]]/>
            <div class="card-body">
                <h4 class="card-title">@GameRegionData.Data[(int)gameRegion].MapName</h4>
                <div class="card-text timercontain@((int)gameRegion)" style="border-radius:10px; padding:5px;">
                    Opens in <span class="time Timer@((int)gameRegion)">00:00:00</span>
                </div>
                <button type="button" class="btn w-fit"
                    style=" background-image:linear-gradient(to right,@GameRegionData.Data[(int)gameRegion].Color1, @GameRegionData.Data[(int)gameRegion].Color2);
                            background-origin:border-box;"
                    >
                    <a href="/@links[(int)gameRegion]">Guide <i class="bi bi-chevron-double-right"></i></a>
                </button>
            </div>
            
        </div>
    }
}

<script>
    function ConvertLocalToLocal(){
        var times = document.getElementsByClassName("localtime");
        for(var t of times){
            ConvertToLocal(t);
        }
    }
</script>


