@using ConvergenceCorpBlazor.Classes.Model.News;

@if(article != null)
{
    <a href="@article.Link" style="text-decoration:none;">
        <div class="card" 
            style="width:250px;height:100%;
            border:var(--primary-brand-color) 1px solid;
            border-radius:10px;
            background-color:var(--secondary-brand-color);">
            <img class="card-img-top" src=@Assets[@article.ImageLink]/>
            <div class="card-body">
                <h4 class="card-title text-align-start">@article.Title</h4>
                <p class="articledates time card-subtitle text-align-start">@article.PublishDate</p>
                <p class="card-text text-align-start">@article.Snippet</p>
            </div>
        </div>
    </a>
}
else
{
    <div>
        Article @NewsID not found!
    </div>
}


@code {
    [Parameter]
    public int NewsID { get; set; } = 0;


    Article? article;

    protected override void OnParametersSet()
    {
        /*
         * This code is fragile because it assumes the articles array does not have any empty gaps between IDs.
         */
        article = Article.Articles[NewsID];

        base.OnParametersSet();
    }
}
