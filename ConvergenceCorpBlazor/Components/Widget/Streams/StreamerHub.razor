@using ConvergenceCorpBlazor.Classes.TwitchApi.Streamers;

<h2>Streamer Division</h2>
Live NOW!
<div style="display:flex; flex-direction:row; flex-wrap:wrap; justify-content:center;">
   
    @for(int i = 0; i < 3 && i < live.Count; ++i)
    {
        <div class="streamer-box">
            <a href="streams/@live[i].id">
                <img src=@live[i].thumbnail_url.Replace("{width}x{height}", "640x360") />
                <div style="display:flex;">
                    <div style="padding:5px;">
                        <img src=@live[i].profile_image_url style="border:2px solid @live[i].color;width:32px; border-radius:16px;" />
                    </div>
                    <div>
                        <div>@live[i].display_name</div>
                            @if(live[i].title.Length > 64)
                            {
                                <div>@live[i].title.Substring(0,64)...</div>
                            }
                            else
                            {
                                <div>@live[i].title</div>
                            }
                        
                        <div>@live[i].game_name</div>
                        <div class="viewcount">o @live[i].viewer_count Viewers</div>
                    </div>
                
                </div>
            </a>
        </div>
    
    }
    @if(live == null || live.Count == 0)
    {
        <div>There are no streamers live at this time.</div>
    }
</div>
<div><a href="/streams">All Streamers -></a></div>




@code {
    List<Streamer> live = Streamer.GetLiveStreamers();
}