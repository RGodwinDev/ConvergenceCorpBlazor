@using ConvergenceCorpBlazor.Classes.TwitchApi.Streamers;
@using ConvergenceCorpBlazor.Components.Widget.Streams;
<h2>Streamer Division</h2>
<div class="d-flex flex-row gap-5">
    @if(live.Count > 0)
    {
        <div>Live NOW!</div>
    }
    <a href="/streams">All Streamers <i class="bi bi-chevron-double-right"></i></a>
</div>
<div class="d-flex flex-row gap-5 max-w-100 overflow-x-scroll" style="scrollbar-width:none;">
    <!-- dont need to limit because scrolling tech woo (do limit it again if we somehow grow to insane amounts of streamers. i<limit && i < live.Count) -->
    @for(int i = 0; i < live.Count; ++i) 
    {
        <SingleStreamerBox Streamer=@live[i] />
    }
    @if(live == null || live.Count == 0)
    {
        <div>There are no streamers live at this time.</div>
    }
</div>




@code {
    List<Streamer> live = Streamer.GetLiveStreamers();
}