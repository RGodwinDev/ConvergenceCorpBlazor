@if (disctype == 0)
{
    <a href=@discordlink target="_blank">Join the Discord! <img src=@discordbutton alt="discord button" /></a>
}
else if (disctype == 1)
{
    <a href=@discordlink target="_blank">Discord! <img src=@discordbutton alt="discord button" /></a>
}
else if(disctype == 2)
{
    <a href=@discordlink target="_blank">Discord</a>
}

@code {
    private static readonly String discordlink = "https://discord.convergencecorp.net";
    private static readonly String discordbutton = "https://discord.com/api/guilds/1247627166733172818/widget.png";

    [Parameter]
    public int disctype { get; set; } = 0;

} 