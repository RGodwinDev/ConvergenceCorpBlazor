@using ConvergenceCorpBlazor.Classes.Model.News;
@rendermode InteractiveServer
@inject IJSRuntime JS

<h2>News</h2>

<div style="display:flex;flex-direction:row;justify-content:center;flex-wrap:wrap;">
    @for(int i = Article.Articles.Count-1; i >= 0 && i > Article.Articles.Count-4; --i)
    {
        <SingleNewsBox NewsID=i/>
    }
</div>
<a href="/news">More news -></a>
<script>
    function ConvertHomePageNewsTimes(){
        var Dates = document.getElementsByClassName("articledates");
        for (var d of Dates) {
            ConvertToLongLocal(d);
        }
    }
   
</script>
@code {
    protected override void OnAfterRender(bool firstRender)
    {
        JS.InvokeVoidAsync("ConvertHomePageNewsTimes");
        base.OnAfterRender(firstRender);
    }
}
