@using ConvergenceCorpBlazor.Classes.TwitchApi.Streamers;

<PageTitle>@streamer.display_name | Convergence Corp!</PageTitle>
<HeadContent>
    <meta name="description" content="Streaming on Convergence Corp! @streamer.display_name">
    <link rel="canonical" href="https://convergencecorp.net/streams/@id" />
    <meta property="og:title" content="@streamer.display_name | Convergence Corp!" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://convergencecorp.net/streams/@id" />
    <meta property="og:image" content="https://convergencecorp.net/favicon/android-chrome-512x512.png" />
    <meta property="og:description" content="Streaming on Convergence Corp! @streamer.display_name" />
    <meta property="og:site_name" content="Convergence Corp!" />
</HeadContent>


@page "/streams/{id}"
<div style="width:100%; display:flex;flex-direction:column;align-items:center;">
    @if(streamer != null)
    {
        @if(streamer.IsLive){
            <div class="stream-and-chat-container">       
            <div class="video-container">
                <iframe width="854"
                        height="480"
                        src="https://player.twitch.tv/?channel=@streamer.login&parent=localhost&parent=convergencecorp.net&autoplay=true&muted=false"
                        frameborder="0"
                        allow="accelerometer;encrypted-media;gyroscope;web-share"
                        scrolling="no"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen>
                </iframe>
            </div>
            <div class="chat-container">
                <iframe
                    src="https://www.twitch.tv/embed/@streamer.login/chat?parent=localhost&parent=convergencecorp.net&darkpopout"
                    height="100%"
                    width="100%"
                        sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-modals"
                    style="border-width:0px;min-height:500px;">
                </iframe>
            </div>
        </div>
        }
        else{
            <div>
                @if(streamer.offline_image_url.Length > 0)
                {
                    <img src=@streamer.offline_image_url style="width:400px;"/>
                }
                else
                {
                    <img src=@Assets["images/Streamers/DefaultOffline.png"] style="width:400px;"/>
                }
            </div>
        }

        <div class="streamer-first-box">
            <div style="display:flex;flex-direction:row;align-items:center;">
                <img src=@streamer.profile_image_url style="width:64px; border-radius:32px; border:solid 2px @streamer.color;" />
                <div>@streamer.display_name</div>
            </div>

            <div>
                <a target="_blank" href="https://twitch.tv/@streamer.login">Watch on Twitch! <img src=@Assets["images/Brands/Twitch/glitch_flat_white.png"] style="width:20px;" /></a>
            </div>
        </div>
        @if (streamer.IsLive)
        {
            <div class="streamer-info-box">
                <p>
                    @streamer.title
                </p>
                <div style="display:flex; flex-wrap:wrap;">
                    Tags:
                    @foreach (string tag in streamer.tags)
                    {
                        <span style="border:2px solid var(--primary-brand-color);background-color:var(--secondary-brand-color); border-radius:10px; padding:3px;">@tag </span>
                    }

                </div>
            </div>
        }
        <div class="streamer-info-box">
            <h2>About</h2>
            <p>
                @streamer.description
            </p>
            
        </div>
    }
    else
    {
        <div>The given ID does not match any streamer that is on Convergence Corp!</div>
        <div>If you think this is an error, please contact me on discord :)</div>
        <a href="/streams">back to streams</a>
    }
</div>

@code {
    [Parameter]
    public String? id { get; set; } = "";
    public Streamer? streamer = null;

    protected override void OnParametersSet()
    {
        if(id != null)
        {
            streamer = Streamer.GetStreamer(id);
        }
    }
}
