@using ConvergenceCorpBlazor.Components.Pages.VisionsOfEternity.Sections.Visions;
<section id="Visions">
    <h2>Vloxx's Visions</h2>
    <p>
        After the pre event, and when Vloxx hits 70% and 40% HP, Isgarren will open 2 portals.
        Each portal leads to a different Vision that Vloxx has created.
        Which visions are shown is random at each phase, but all 6 will be used by the end of the fight.
    </p>
    <p>
        Half of your squad should go into each of the portals.
    </p>

    <!-- Vision sections -->
    <VisionAffliction />
    <VisionCollapse />
    <VisionEnd />
    <VisionImpendingDoom />
    <VisionIneptitude />
    <VisionZealotry />
</section>