@using ConvergenceCorpBlazor.Classes.Model.News;
@rendermode InteractiveServer
@inject IJSRuntime JS

@page "/News"
<HeadContent>
    <title>News! | Convergence Corp!</title>
    <meta name="description" content="The latest news from Convergence Corp!">
    <link rel="canonical" href="https://convergencecorp.net/news" />
    <meta property="og:title" content="News! | Convergence Corp!" />
    <meta property="og:url" content="https://convergencecorp.net/news" />
    <meta property="og:image" content="https://convergencecorp.net/favicon/android-chrome-512x512.png" />
    <meta property="og:description" content="The latest news from Convergence Corp!" />
</HeadContent>
<article>
<h1>News</h1>
<div style="display:flex;flex-direction:row;justify-content:center;flex-wrap:wrap;">
    @for(int i = Article.Articles.Count-1; i >= 0; --i)
    {
        <SingleNewsBox NewsID=i />
    }
</div>
</article>

<script>
    

    function ConvertNewsTimesToLocal(){
        var Dates = document.getElementsByClassName("articledates");
        for(var d of Dates){
            ConvertToLongLocal(d);
        }
    }
    
</script>
@code {

    protected override void OnAfterRender(bool firstRender)
    {
        JS.InvokeVoidAsync("ConvertNewsTimesToLocal");
        base.OnAfterRender(firstRender);
    }
}
