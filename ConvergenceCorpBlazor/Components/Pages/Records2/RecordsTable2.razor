<script>
    function FormatRecordDates(){
        var x = document.getElementsByClassName("recDate");
        for (var y of x) {
            let d = new Date(y.innerText);
            let z = d.toLocaleDateString();
            if (z != "Invalid Date") {
                y.innerText = d.toLocaleDateString();
            }
        }
    }
</script>


@code {
    [Parameter]
    public Region Region { get; set; } = Region.None;
    [Parameter]
    public Season Season { get; set; } = Season.None;

    //this could be an array.
    ConvergenceRun DemonKnight =    new ConvergenceRun(-1, Bosses.DemonKnight,  new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Dreadwing =      new ConvergenceRun(-2, Bosses.Dreadwing,    new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Hellsister =     new ConvergenceRun(-3, Bosses.HellSister,   new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Sorrow =         new ConvergenceRun(-4, Bosses.Sorrow,       new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Umbriel =        new ConvergenceRun(-5, Bosses.Umbriel,      new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Decima =         new ConvergenceRun(-6, Bosses.Decima,       new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Greer =          new ConvergenceRun(-7, Bosses.Greer,        new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Ura =            new ConvergenceRun(-8, Bosses.Ura,          new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
    ConvergenceRun Vloxx =          new ConvergenceRun(-9, Bosses.Vloxx,        new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());

    protected override void OnParametersSet()
    {
        DateTimeOffset Start = new DateTimeOffset(2024, 11, 11, 11, 11, 11, new TimeSpan(0, 0, 0));
        DateTimeOffset End = DateTimeOffset.UtcNow;

        if(Season == Season.Jul2026)
        {
            Start = new DateTimeOffset(2026, 07, 15, 11, 00, 00, new TimeSpan(-5, 0, 0));
        }
        if(Season == Season.Apr2026)
        {
            Start = new DateTimeOffset(2026, 04, 14, 11, 00, 00, new TimeSpan(-5, 0, 0));
            End = new DateTimeOffset(2026, 07, 15, 10, 59, 59, new TimeSpan(-5, 0, 0));
        }
        else if (Season == Season.Feb2026)
        {
            Start = new DateTimeOffset(2026, 02, 04, 11, 00, 00, new TimeSpan(-5, 0, 0));
            End = new DateTimeOffset(2026, 04, 14, 10, 59, 59, new TimeSpan(-5, 0, 0));
        }

        //RESET THE VALUES
        DemonKnight = new ConvergenceRun(-1, Bosses.DemonKnight, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Dreadwing = new ConvergenceRun(-2, Bosses.Dreadwing, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Hellsister = new ConvergenceRun(-3, Bosses.HellSister, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Sorrow = new ConvergenceRun(-4, Bosses.Sorrow, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Umbriel = new ConvergenceRun(-5, Bosses.Umbriel, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Decima = new ConvergenceRun(-6, Bosses.Decima, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Greer = new ConvergenceRun(-7, Bosses.Greer, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Ura = new ConvergenceRun(-8, Bosses.Ura, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());
        Vloxx = new ConvergenceRun(-9, Bosses.Vloxx, new TimeSpan(00, 00, 20, 00, 000), "n/a", "n/a", Region.None, new DateTimeOffset());


        List<ConvergenceRun> Runs = ConvergenceRun.GetRegionRuns(Region, Start, End);
        for(int i = 0; i < Runs.Count; ++i)
        {
            ConvergenceRun r = Runs[i];
            if(r.boss == Bosses.DemonKnight && r.time < DemonKnight.time)
            {
                DemonKnight = r;
            }
            else if(r.boss == Bosses.Dreadwing && r.time < Dreadwing.time)
            {
                Dreadwing = r;
            }
            else if(r.boss == Bosses.HellSister && r.time < Hellsister.time)
            {
                Hellsister = r;
            }
            else if(r.boss == Bosses.Sorrow && r.time < Sorrow.time)
            {
                Sorrow = r;
            }
            else if(r.boss == Bosses.Umbriel && r.time < Umbriel.time)
            {
                Umbriel = r;
            }
            else if(r.boss == Bosses.Decima && r.time < Decima.time)
            {
                Decima = r;
            }
            else if(r.boss == Bosses.Greer && r.time < Greer.time)
            {
                Greer = r;
            }
            else if(r.boss == Bosses.Ura && r.time < Ura.time)
            {
                Ura = r;
            }
            else if(r.boss == Bosses.Vloxx && r.time < Vloxx.time)
            {
                Vloxx = r;
            }
        }
        base.OnParametersSet();
    }
}
