@rendermode InteractiveServer

<div class="container-fluid">
<nav class="nav top-row">
    <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">
        <image src="/favicon2/android-chrome-192x192.png" alt="CC Favicon" style="width:50px;"/> Convergence Corp!
    </NavLink>
</nav>

<!-- the checkbox IS the hamburger menu button -->
<input type="checkbox" title="Navigation menu" class="navbar-toggler" /> 

<div class="nav-scrollable container-fluid" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav">
        <div class="nav-item">
            <NavLink class="nav-link" @onclick="changeCvrgMenu">
                <img class="nav-link-icon" src="https://render.guildwars2.com/file/A6012206459C56680D1BD4D23E0B706F0B0AE40D/3630024.png" alt="Convergences" />
                Convergences!
            </NavLink>
            @if (cvrgMenu)
            {
                <div class="menu show">
                    <NavLink class="menu-item" href="soto">
                        <img class="nav-link-icon" src=@Assets["/images/SotO/Secrets_of_the_Obscure_logo.png"] alt="Secrets of the Obscure" />Outer Nayos
                    </NavLink>
                    <NavLink class="menu-item" href="jw">
                            <img class="nav-link-icon" src=@Assets["/images/JW/Janthir_Wilds_logo.png"] alt="Janthir Wilds" />Mount Balrior
                    </NavLink>
                    <NavLink class="menu-item" href="voe">
                        <img class="nav-link-icon" src=@Assets["/images/VoE/VoE_logo_gradient_800.png"] alt="Visions of Eternity" />Nexus of Eternity
                    </NavLink>
                </div>
            }
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="schedule">
                <span class="nav-link-emoji">&#128197;</span> Schedule
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="records">
                <image class="nav-link-icon" src="https://render.guildwars2.com/file/BDDD04A42D0AF79E9ED761083B032243F8E0C8CD/3630912.png" alt="Records" /> Records
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="builds">
                <image class="nav-link-icon" src="https://render.guildwars2.com/file/A70C929E10EE010851B3FF5FCCBAE5630496B746/103427.png" alt="Builds" /> Builds
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="addons">
                <span class="nav-link-emoji">&#128187;</span>Addons
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" @onclick="changeOtherMenu">
                <image class="nav-link-icon" src="https://render.guildwars2.com/file/43C10FB3C60AFBC9CFD50413170A4D553A0046D8/740204.png" alt="Other guides" />
                Other Guides
            </NavLink>
                @if (otherMenu)
                {
                    <div class="menu show">
                        <div class="nav-item">
                            <NavLink class="nav-link" href="festivals">
                                <image class="nav-link-icon" src="https://render.guildwars2.com/file/00ED7EC9BB0A01045205ED6144FB24E9189B25C2/1822094.png" alt="Festivals" /> Festivals
                            </NavLink>
                        </div>
                    </div>
                }
            
        </div>
        <!--
        <div class="nav-item">
            <NavLink class="nav-link" href="movement">
                <image class="nav-link-icon" src="https://render.guildwars2.com/file/2F4AAA52F573C5425BFCD7525FB70C9E6DCAD791/1766903.png" alt="Movement"/> Movement
            </NavLink>
        </div>
        -->
        <div class="nav-item">
            <NavLink class="nav-link" href="news">
                <image class="nav-link-icon" src="https://render.guildwars2.com/file/BC2EACDA78BC950263F901E8EBA6E74D08E97E23/2596976.png" alt="News"/> News
            </NavLink>
        </div>
    </nav>
</div>

</div>


@code{
    private void changeCvrgMenu()
    {
        cvrgMenu = !cvrgMenu;
    }
    private void changeOtherMenu()
    {
        otherMenu = !otherMenu;
    }
    private bool cvrgMenu = false;
    private bool otherMenu = false;

}